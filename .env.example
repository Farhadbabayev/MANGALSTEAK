# ------------------------------------------------------------------
#  Mangal Steak House — server konfiqurasiyası
#  Bu faylı ".env" adı ilə kopyalayın və dəyərləri doldurun.
#    cp .env.example .env
#
#  DİQQƏT (Vercel): lazım olmayan açarı BOŞ dəyərlə əlavə etməyin —
#  sadəcə əlavə etməyin. Boş dəyər «təyin olunmayıb» sayılır və
#  standart dəyər işə düşür, amma açarı tamam silmək daha təmizdir.
# ------------------------------------------------------------------

PORT=3000
HOST=0.0.0.0
SITE_URL=https://mangalsteakhouse.az
RESTAURANT_NAME=Mangal Steak House

# Nginx / Cloudflare arxasındadırsa true edin (real IP-nin tanınması üçün)
TRUST_PROXY=false


# ------------------------------------------------------------------
#  VILKA İNTEQRASİYASI
#
#  QEYD: Bu dəyərləri idarəetmə panelinin «Rezervasiya sistemi»
#  bölməsindən də doldurmaq olar. Paneldən yazılan dəyərlər
#  data/integration.json faylında saxlanılır və buradakıları üstələyir.
#  Müştəri saytdan çıxmır — forma bizim serverə göndərilir,
#  server isə rezervasiyanı Vilka-ya ötürür.
#
#  VILKA_MODE:
#    off      — yalnız daxili anbar (sayt Vilka olmadan da işləyir)
#    api      — Vilka-nın rezervasiya API-sinə birbaşa POST
#    webhook  — aralıq webhook-a POST (Make / n8n / Zapier və s.)
# ------------------------------------------------------------------

VILKA_MODE=off

# Vilka-nın rezervasiya qəbul edən ünvanı (Vilka super-admin → İnteqrasiyalar (API)).
# Mangal Steak House üçün:
#   https://mqirnsmgnymjnyabvurr.supabase.co/functions/v1/api-v1/r/mangal-steak-house/reservations
VILKA_API_URL=

# Vilka panelində yaradılan açar (vk_live_… ilə başlayır)
VILKA_API_KEY=
VILKA_AUTH_HEADER=Authorization

# Açar hansı sxemlə göndərilsin. Bəzi API-lər açarı sxemsiz, olduğu kimi
# gözləyir (məs. VILKA_AUTH_HEADER=X-Api-Key) — o zaman «none» yazın.
VILKA_AUTH_SCHEME=Bearer

# Vilka üçün lazım deyil — restoranı açar özü müəyyən edir
# (başqa sistem tələb edərsə doldurun)
VILKA_RESTAURANT_ID=

# Sahə adlarının uyğunlaşdırılması — Vilka üçün BOŞ buraxın.
# VILKA_MODE=api olanda sayt Vilka-nın öz adlarını avtomatik göndərir:
#   guest_name / guest_phone / party_size / date / time / starts_at /
#   external_ref (rezervasiya kodu) / note (zona + səbəb + qeyd)
# Yalnız başqa sistem üçün və ya bu adları üstələmək lazımdırsa doldurun.
# Sol tərəf — bizim sahə, sağ tərəf — onların sahəsi.
VILKA_FIELD_MAP=

# Hər sorğuya əlavə olunacaq sabit sahələr.
# Nümunə: {"branch_id":3,"channel":"website"}
VILKA_EXTRA_FIELDS=

VILKA_TIMEOUT_MS=15000
VILKA_RETRY_ATTEMPTS=4
VILKA_RETRY_INTERVAL_MS=300000


# ------------------------------------------------------------------
#  ADMIN PANELİ  ->  /admin
#  Şifrə boşdursa panel tamamilə söndürülür.
# ------------------------------------------------------------------

ADMIN_USER=admin
ADMIN_PASSWORD=


# ------------------------------------------------------------------
#  GITHUB  —  yalnız Vercel kimi «yalnız oxunan» hostinqlər üçün
#
#  Öz serverinizdə lazım DEYİL: panel fayllara birbaşa yazır.
#  Vercel-də isə diskə yazmaq olmur, ona görə panel dəyişikliyi
#  repoya commit edir, Vercel isə push-u görüb saytı yenidən yığır.
#
#  Token: GitHub -> Settings -> Developer settings ->
#  Personal access tokens -> Fine-grained tokens
#  İcazə: Repository permissions -> Contents: Read and write
#
#  DİQQƏT: tokeni bu fayla yazıb repoya göndərməyin —
#  Vercel -> Settings -> Environment Variables bölməsinə yazın.
#
#  GITHUB_REPO və GITHUB_BRANCH Vercel-də LAZIM DEYİL: funksiya onları
#  VERCEL_GIT_REPO_OWNER / VERCEL_GIT_REPO_SLUG / VERCEL_GIT_COMMIT_REF
#  dəyişənlərindən özü tapır və həmişə saytın yığıldığı budağa yazır.
#  Aşağıdakılar yalnız bunu əl ilə üstələmək istəsəniz lazımdır.
# ------------------------------------------------------------------

GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=


# ------------------------------------------------------------------
#  TELEGRAM BİLDİRİŞİ (istəyə bağlı, çox tövsiyə olunur)
#  Hər rezervasiya heyətin Telegram qrupuna düşür —
#  Vilka-ya ötürmə uğursuz olsa belə sifariş itmir.
# ------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ONLY_FAILURES=false


# ------------------------------------------------------------------
#  QORUMA
# ------------------------------------------------------------------

# Bir IP-dən saatda maksimum rezervasiya sayı
RATE_LIMIT_PER_HOUR=8
MAX_BODY_BYTES=32768
